#!/bin/bash
# ns - NDLデジタルコレクション検索ツール
# 使い方: ns キーワード [年代] [資料種別]
#   ns 八月二十一日              → 全コレクション検索
#   ns 八月二十一日 1940         → 1940〜1950年に絞り込み
#   ns 八月二十一日 1940 雑誌    → 1940〜1950年の雑誌のみ

if [ $# -lt 1 ]; then
    echo "使い方: ns キーワード [年代] [資料種別]"
    echo ""
    echo "  年代: 1940 と入力すると 1940〜1950 の範囲で検索"
    echo "  資料種別: 図書 / 雑誌 / 新聞 / 古典籍 / 博士論文 / 官報"
    echo "           (省略時は全コレクション)"
    exit 1
fi

KEYWORD="$1"
YEAR="$2"
TYPE="$3"

# キーワードをURLエンコード
ENCODED_KEYWORD=$(python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$KEYWORD")

# 閲覧制限（インターネット公開 + 送信サービス）
BASE="https://dl.ndl.go.jp/search/searchResult"
PARAMS="accessRestrictions=internet&accessRestrictions=ooc"

# コレクション設定
case "$TYPE" in
    図書)
        PARAMS="${PARAMS}&collection=A00001"
        ;;
    雑誌)
        PARAMS="${PARAMS}&collection=A00002"
        ;;
    新聞)
        PARAMS="${PARAMS}&collection=A00022"
        ;;
    古典籍)
        PARAMS="${PARAMS}&collection=A00003"
        ;;
    博士論文)
        PARAMS="${PARAMS}&collection=A00014"
        ;;
    官報)
        PARAMS="${PARAMS}&collection=A00015"
        ;;
    帝国議会)
        PARAMS="${PARAMS}&collection=A00188"
        ;;
    憲政資料)
        PARAMS="${PARAMS}&collection=A00017"
        ;;
    占領)
        PARAMS="${PARAMS}&collection=A00016"
        ;;
    プランゲ)
        PARAMS="${PARAMS}&collection=A00019"
        ;;
    音源)
        PARAMS="${PARAMS}&collection=A00024"
        ;;
    地図)
        PARAMS="${PARAMS}&collection=A00152"
        ;;
    電子)
        PARAMS="${PARAMS}&collection=B00000"
        ;;
    ""|全)
        PARAMS="${PARAMS}&collection=A00001&collection=A00002&collection=A00022&collection=A00003&collection=A00014&collection=A00015&collection=A00188&collection=A00017&collection=A00016&collection=A00019&collection=A00121&collection=A00024&collection=A00152&collection=A00150&collection=A00173&collection=A00122&collection=A00162&collection=B00000"
        ;;
    *)
        echo "不明な資料種別: $TYPE"
        echo "使用可能: 図書 / 雑誌 / 新聞 / 古典籍 / 博士論文 / 官報 / 帝国議会 / 憲政資料 / 占領 / プランゲ / 音源 / 地図 / 電子 / 全"
        exit 1
        ;;
esac

# 共通パラメータ
PARAMS="${PARAMS}&keyword=${ENCODED_KEYWORD}&fullText=true&eraType=AD&availableType=Persend&identifierItem=ISBN&includeVolumeNum=true"

# 年代指定
if [ -n "$YEAR" ]; then
    YEAR_TO=$((YEAR + 10))
    YEAR_FACET_TO=$((YEAR + 9))
    PARAMS="${PARAMS}&issuedFrom=${YEAR}&issuedTo=${YEAR_TO}&publishEra_facet=${YEAR}-${YEAR_FACET_TO}"
fi

# ソート・表示設定
PARAMS="${PARAMS}&pageNum=0&pageSize=100&sortKey=ISSUED_ASC&displayMode=list"

URL="${BASE}?${PARAMS}"

echo "検索: ${KEYWORD}"
[ -n "$YEAR" ] && echo "年代: ${YEAR}〜${YEAR_TO}"
[ -n "$TYPE" ] && echo "種別: ${TYPE}"
echo ""

open "$URL"
